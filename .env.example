# Copy to .env and fill in. Used with:  docker run --env-file .env ...
# (or docker compose --env-file .env up, if you use the provided docker-compose.yml)

# --- Steam account (label only, unless USE_STEAMCMD=1) ---
# The bot's Steam login name. Since the 2026-08-05 switch to the GUI-first install flow
# nothing in the container logs in on your behalf -- a human types the password + Steam
# Guard code into the graphical client once, over VNC -- so this is now just the name shown
# in log lines and banners. It becomes REQUIRED again if you set USE_STEAMCMD=1 below.
STEAM_ACCOUNT=your_bot_steam_account

# --- Install source (see the boot-order comment in infra/docker-entrypoint.sh) ---
# 0 (default): the game is installed by a human from the graphical Steam client's Library
#   over VNC, and the entrypoint waits for it. Liftoff cannot be installed through steamcmd
#   on this account, which is why this is the default.
# 1: restore the old behavior -- steamcmd runs `+login $STEAM_ACCOUNT +app_update 410340
#   validate` at every boot against /steam/Liftoff. Kept for possible future Workshop
#   tooling; needs a one-time interactive steamcmd prime (see docker-compose.yml's header).
# USE_STEAMCMD=0
#
# How long the entrypoint waits for that human install before exiting (seconds; default
# 14400 = 4h). A restart resumes the wait -- Steam's partial download lives in the volume.
# GAME_INSTALL_TIMEOUT=14400

# --- Admin chat commands (optional; fail-closed if left unset) ---
# Comma and/or newline separated Photon user IDs allowed to run admin-only chat commands
# (/interval, /kick, ...). Written to BepInEx/plugins/admin_ids.txt on every boot. Leaving
# this unset is NOT an error -- it reproduces the plugin's existing fail-closed default (no
# admin_ids.txt -> no admins for anyone), it just means nobody can use admin commands until
# you set this. See docs/features/doing/container-seed-admin-ids.md. Alternative: mount a
# file at /config/admin_ids.txt (one ID per line, '#' comments allowed) instead of using this
# var -- ADMIN_IDS takes precedence over that file when both are present.
# ADMIN_IDS=139333,288094

# --- Lobby / rotation (all optional, defaults shown) ---
PLAYLIST=all_official_races
INTERVAL=90
SHUFFLE=false
PUBLIC=false
AUTO_START=false
LOBBY_NAME=Procedural Loop Room
WIDTH=640
HEIGHT=480
# MAX_PLAYERS=8

# --- Dashboard sidecar (docker compose up -d dashboard; see docker-compose.yml's
#     `dashboard` service and docs/features/doing/bot-dashboard.md's deployment section) ---
# D2 (operator decision, bot-dashboard.md): single shared token, config-sourced. Required --
# `python -m dashboard` refuses to start without one (dashboard/__main__.py). NOTE the real
# variable name is FPV_DASHBOARD_TOKEN (dashboard/control/settings.py), not DASHBOARD_TOKEN --
# match the code, not shorthand you may see elsewhere. NEVER commit a real value here; this
# is a placeholder only.
# FPV_DASHBOARD_TOKEN=generate-with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
#
# D3: the container-restart button is DISABLED by default and stays inert unless BOTH of the
# following are set (docker-compose.yml does not set either -- opt in deliberately):
# FPV_DASHBOARD_ALLOW_RESTART=1
# FPV_BOT_CONTAINER=bot
#
# FPV_DASHBOARD_HOST / FPV_DASHBOARD_PORT are pinned directly in docker-compose.yml's
# `dashboard` service (0.0.0.0:8800, matching the `127.0.0.1:8800:8800` publish) so they are
# NOT set here -- setting them in this file would have no effect on the compose deployment
# (compose `environment:` wins over `env_file:` for the same key) and could confuse a plain
# `python -m dashboard` run outside Docker, which DOES read them from here/the shell.

# --- Advanced (rarely need changing) ---
# DISPLAY=:99
# Where the game is installed. Leave unset: the entrypoint auto-detects the client's own
# library (/steam/.steam/debian-installation/steamapps/common/Liftoff) first, then the
# steamcmd location (/steam/Liftoff). Set it only for a non-default library folder.
# LIFTOFF_INSTALL_DIR=
# STEAMCMD_TIMEOUT=900        # only used when USE_STEAMCMD=1
# STEAM_READY_TIMEOUT=600     # Steam client cold-boot/readiness budget
# STEAM_LOGIN_TIMEOUT=1800    # budget for the one-time interactive VNC login
