# Copy to .env and fill in. Used with:  docker run --env-file .env ...
# (or docker compose --env-file .env up, if you use the provided docker-compose.yml)

# --- Required ---
# The Steam account login name whose session was primed (once, interactively) into the
# /steam volume. See docs/features/doing/docker-container.md "Human dependency" section --
# this cannot be automated: it needs a human to type a password + Steam Guard code the
# first time (and again whenever the cached token expires/is revoked).
STEAM_ACCOUNT=your_bot_steam_account

# --- Admin chat commands (optional; fail-closed if left unset) ---
# Comma and/or newline separated Photon user IDs allowed to run admin-only chat commands
# (/interval, /kick, ...). Written to BepInEx/plugins/admin_ids.txt on every boot. Leaving
# this unset is NOT an error -- it reproduces the plugin's existing fail-closed default (no
# admin_ids.txt -> no admins for anyone), it just means nobody can use admin commands until
# you set this. See docs/features/doing/container-seed-admin-ids.md. Alternative: mount a
# file at /config/admin_ids.txt (one ID per line, '#' comments allowed) instead of using this
# var -- ADMIN_IDS takes precedence over that file when both are present.
# ADMIN_IDS=139333,288094

# --- Lobby / rotation (all optional, defaults shown) ---
PLAYLIST=all_official_races
INTERVAL=90
SHUFFLE=false
PUBLIC=false
AUTO_START=false
LOBBY_NAME=Procedural Loop Room
WIDTH=640
HEIGHT=480
# MAX_PLAYERS=8

# --- Advanced (rarely need changing) ---
# DISPLAY=:99
# LIFTOFF_INSTALL_DIR=/steam/Liftoff
# STEAMCMD_TIMEOUT=900
