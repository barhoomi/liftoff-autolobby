<?xml version="1.0" encoding="utf-8"?>
<!--
  BepInEx.Core is not published to nuget.org; BepInEx publishes its own packages via a
  dedicated feed (see plugin/LiftoffAutoLobby.csproj for why: NuGet, not a Liftoff install,
  is the source for the modding framework DLLs). HarmonyX ships on nuget.org as usual.
  Referenced by build-release-pipeline.md R1 item 1.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="bepinex" value="https://nuget.bepinex.dev/v3/index.json" />
  </packageSources>
</configuration>
